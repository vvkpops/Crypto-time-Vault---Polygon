# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains your private key

# Your wallet private key (without 0x prefix is fine)
# Export from MetaMask: Account Details → Export Private Key
PRIVATE_KEY=your_private_key_here

# Get a free API key from https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key

# Get a free API key from https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Optional: custom Polygon RPC (default: Ankr free public)
# Get a free dedicated endpoint at https://www.alchemy.com or https://infura.io
POLYGON_RPC=https://rpc.ankr.com/polygon

# Optional: how often the auto-withdraw daemon checks for expired locks (seconds)
# Default: 60
POLL_INTERVAL=60
