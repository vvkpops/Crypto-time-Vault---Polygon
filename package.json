{
  "name": "time-vault-contracts",
  "version": "1.0.0",
  "description": "TimeVault – self-custody time-locked savings on Base / Polygon",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:frontend": "cd frontend && npm run test",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:all": "hardhat test && cd frontend && npm run test:all",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "auto-withdraw": "node scripts/auto-withdraw.js",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^17.3.1",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
